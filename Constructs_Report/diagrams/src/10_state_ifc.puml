@startuml
!include _style.iuml
hide empty description
[*] --> UPLOADED
UPLOADED --> VALIDATING
UPLOADED --> QUEUED
VALIDATING --> QUEUED
QUEUED --> PARSING
PARSING --> BUILDING_HIERARCHY
BUILDING_HIERARCHY --> EXTRACTING_ELEMENTS
EXTRACTING_ELEMENTS --> EXTRACTING_PROPERTIES
EXTRACTING_PROPERTIES --> QUALITY_CHECKS
QUALITY_CHECKS --> ANALYZING
ANALYZING --> READY
ANALYZING --> READY_WITH_WARNINGS
FAILED --> QUEUED : retry
READY_WITH_WARNINGS --> QUEUED : reprocess
READY --> ARCHIVED
READY_WITH_WARNINGS --> ARCHIVED
FAILED --> ARCHIVED
UPLOADED --> ARCHIVED
ARCHIVED --> READY : restore
ARCHIVED --> READY_WITH_WARNINGS : restore
note "Every processing state (UPLOADED ... ANALYZING)\nmay also move to FAILED." as N1
@enduml
