# Local Docker example. Railway should use the managed PostgreSQL DATABASE_URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/construction_platform
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_RANDOM_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private_uploads
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_USE_TLS=true
OPENAI_API_KEY=replace-with-server-side-key
IFC_FEATURE_ENABLED=true
IFC_MAX_FILE_MB=500
IFC_PARSE_TIMEOUT_SECONDS=600
IFC_GEOMETRY_ENABLED=true
IFC_GEOMETRY_TIMEOUT_SECONDS=900
IFC_GEOMETRY_MAX_VERTICES=8000000
IFC_GEOMETRY_WORKERS=2
IFC_MAX_ENTITY_COUNT=500000
IFC_COMPARISON_ENABLED=true
IFC_COORDINATION_CHECKS_ENABLED=true
IFC_AI_ANALYSIS_ENABLED=false
IFC_AI_MODEL=gpt-5.6-luna
IFC_BACKGROUND_PROCESSING_ENABLED=true
IFC_RETENTION_DAYS=3650
IFC_NOTIFICATION_DIGEST_ENABLED=true
IFC_ENGINEER_UPLOAD_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
VOICE_FEATURE_ENABLED=true
VOICE_TRANSCRIPT_SIMULATION_ENABLED=false
VOICE_MAX_FILE_MB=25
VOICE_MAX_DURATION_SECONDS=180
VOICE_AUDIO_RETENTION_DAYS=30
VOICE_MIN_EXECUTION_CONFIDENCE=0.80

# Optional one-time staging bootstrap. Leave all four unset during normal use.
# Remove all four variables from the deployment environment immediately after
# the first successful login and password change.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_RECOVER_PASSWORD=false

# Optional staging-only demonstration data. ENABLE_DEMO_SEED is ignored unless
# ENVIRONMENT is exactly "staging". Remove the password and enable flag after
# the first successful seed; re-running is safe and does not reset passwords.
ENVIRONMENT=development
ENABLE_DEMO_SEED=false
DEMO_USER_PASSWORD=
DEMO_SEED_ADMIN_EMAIL=
