# Local Docker example. Railway should use the managed PostgreSQL DATABASE_URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/construction_platform
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_RANDOM_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private_uploads
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_USE_TLS=true
OPENAI_API_KEY=replace-with-server-side-key
IFC_FEATURE_ENABLED=true
IFC_MAX_FILE_MB=500
IFC_PARSE_TIMEOUT_SECONDS=600
IFC_GEOMETRY_ENABLED=true
IFC_GEOMETRY_TIMEOUT_SECONDS=900
IFC_GEOMETRY_MAX_VERTICES=8000000
IFC_GEOMETRY_WORKERS=2
# Building elements (IfcProduct) per model — not total STEP records.
IFC_MAX_ENTITY_COUNT=500000
# Memory one IFC parse may use (~16 MB per MB of IFC). Decides the largest
# processable model: 3072 -> ~174 MB. Keep 2 x this under the worker's memory.
IFC_PARSE_MEMORY_MB=3072
IFC_COMPARISON_ENABLED=true
IFC_COORDINATION_CHECKS_ENABLED=true
IFC_AI_ANALYSIS_ENABLED=false
IFC_AI_MODEL=gpt-5.6-luna
IFC_BACKGROUND_PROCESSING_ENABLED=true
IFC_MAX_CONCURRENT_PROCESSING=2
IFC_ENGINEER_UPLOAD_ENABLED=false

# Unified file ingestion (documents, drawings, models, design packages).
# See docs/FILE_INGESTION.md. There is deliberately no separate concurrency
# setting: ingestion shares the pool IFC_MAX_CONCURRENT_PROCESSING bounds,
# because a second ceiling would double the memory bound the first enforces.
INGESTION_ENABLED=true
INGESTION_MAX_FILE_MB=200
INGESTION_BACKGROUND_PROCESSING_ENABLED=true
# ZIP defences. Independent ceilings; a package must pass all of them.
INGESTION_ZIP_MAX_ENTRIES=500
INGESTION_ZIP_MAX_TOTAL_MB=1000
INGESTION_ZIP_MAX_ENTRY_MB=200
# Uncompressed-to-compressed ratio above which an entry is treated as a bomb.
INGESTION_ZIP_MAX_RATIO=100
# 1 = a package is opened, an archive inside it is stored but not opened.
INGESTION_ZIP_MAX_DEPTH=1

OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
VOICE_FEATURE_ENABLED=true
VOICE_TRANSCRIPT_SIMULATION_ENABLED=false
VOICE_MAX_FILE_MB=25
VOICE_MAX_DURATION_SECONDS=180
VOICE_AUDIO_RETENTION_DAYS=30
VOICE_MIN_EXECUTION_CONFIDENCE=0.80

# Optional one-time staging bootstrap. Leave all four unset during normal use.
# Remove all four variables from the deployment environment immediately after
# the first successful login and password change.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_RECOVER_PASSWORD=false

# What kind of deployment this is: development, local, test, qa, staging or
# production. Development-only switches refuse to run unless it says so.
#
# Optional staging-only demonstration data. ENABLE_DEMO_SEED is ignored unless
# ENVIRONMENT is exactly "staging". Remove the password and enable flag after
# the first successful seed; re-running is safe and does not reset passwords.
ENVIRONMENT=development

# Local QA only: return the step-up verification code in the API response, and
# fill it into the dialog, so permission changes can be tested without email.
# The backend refuses to start with this on unless ENVIRONMENT is development,
# local or test. One verification still covers permission changes for
# STEP_UP_VALIDITY_MINUTES (default 10); destructive actions still ask each time.
OTP_DEV_ECHO_ENABLED=false

# Development / QA only: edit role and per-person permissions without a
# verification code. Sign-in and the manage-permissions check still apply, and
# password, reset, deactivate and delete still ask for a code. The backend
# refuses to start with this on unless ENVIRONMENT is development, local, test
# or qa — never set it in staging or production.
STEP_UP_PERMISSION_EDIT_BYPASS=false
ENABLE_DEMO_SEED=false
DEMO_USER_PASSWORD=
DEMO_SEED_ADMIN_EMAIL=

# Whether a domain event may start an agent analysis pass on its own.
# Off by default: proactive analysis writes into people notification queues.
AGENT_AUTO_ANALYSIS_ENABLED=false
