POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD_URLENCODED=CHANGE_ME_URL_ENCODED
POSTGRES_DB=construction_platform
CORS_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:8000
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
VOICE_FEATURE_ENABLED=false
VOICE_TRANSCRIPT_SIMULATION_ENABLED=false
VOICE_MAX_FILE_MB=25
VOICE_MAX_DURATION_SECONDS=180
VOICE_AUDIO_RETENTION_DAYS=30
VOICE_MIN_EXECUTION_CONFIDENCE=0.80

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
# Off by default. With PUSH_ENABLED=false the platform behaves exactly as it
# did before push existed: notifications are still persisted and readable in
# the web notification centre and the mobile notification screen.
PUSH_ENABLED=false
FCM_PROJECT_ID=
# The service account JSON. THIS IS A REAL SECRET — it can send a notification
# to any device registered to the project. Supply exactly one of:
#   FCM_CREDENTIALS_FILE  a path to a mounted file (preferred; use this with
#                         Docker, and keep the file outside the repository)
#   FCM_CREDENTIALS_JSON  the file's contents inline, for a PaaS that offers
#                         only environment variables
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
PUSH_TIMEOUT_SECONDS=10
# Must match the channel the Flutter app creates and the value in
# android/app/src/main/AndroidManifest.xml.
PUSH_ANDROID_CHANNEL_ID=structiq_default
# Deliver on the calling thread. For tests and scripts only — leaving this on
# in a served process puts FCM latency into the request path.
PUSH_SYNCHRONOUS=false
# Development only. Exposes POST /notifications/dev/test-notification, which
# sends a notification to THE CALLER ONLY. Must stay false in production.
NOTIFICATION_DEV_TEST_ENABLED=false

# --- RAG (document question answering) ---------------------------------------
# Off by default. With RAG_ENABLED=false the endpoints return 503 and the rest
# of the application is entirely unaffected.
RAG_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RAG_MODEL=gpt-4.1-mini
# The width of the `document_chunks.embedding` column. Changing this is a
# schema change, not a configuration change: the column is `vector(N)` and a
# migration must move with it. text-embedding-3-small produces 1536.
RAG_EMBEDDING_DIMENSIONS=1536
# How pgvector's HNSW index behaves when a query also filters — which every
# retrieval query here does. Without it the index post-filters and can return
# fewer than RAG_TOP_K rows. Needs pgvector >= 0.8; set empty on older builds.
RAG_HNSW_ITERATIVE_SCAN=strict_order
# --- Re-embedding and index maintenance ---
# How long a row may sit in INDEXING before the reaper treats the run as dead.
# Must comfortably exceed the slowest legitimate index, or it seizes live runs.
RAG_INDEX_STALE_MINUTES=30
# The periodic sweep that recovers stranded runs. Off degrades to the previous
# behaviour: recovery only via an explicit force retry.
RAG_REAPER_ENABLED=true
RAG_REAPER_INTERVAL_MINUTES=10
# Bounded retry, so a deterministically failing run is not retried forever.
RAG_REINDEX_MAX_ATTEMPTS=3
# Guard rail on one run's size. A bigger project needs a deliberate decision
# about cost rather than a button that quietly spends it.
RAG_REINDEX_MAX_SOURCES=500

RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=75
RAG_TOP_K=5
RAG_MAX_FILE_MB=25
RAG_MAX_PAGES=300

# --- Web push: Firebase web app configuration --------------------------------
# Consumed as BUILD args by the frontend image (see frontend/Dockerfile). Vite
# inlines these at compile time, so supplying them only to the running container
# is too late — every field bakes into the bundle as `undefined` and web push
# silently never starts.
#
# These are PUBLIC client identifiers, not credentials, and VAPID_KEY is the
# public half of the key pair. The service account that can actually SEND a
# notification is backend-only (FCM_CREDENTIALS_FILE) and never reaches a
# browser.
#
# Copy from Firebase Console -> Project settings -> General -> Your apps -> Web,
# and the VAPID key from Cloud Messaging -> Web Push certificates.
# Leave empty to build without web push; the app runs normally and logs that
# push is unconfigured.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Realtime (Server-Sent Events) -------------------------------------------
# Keeps an open application synchronized. Distinct from push: SSE is for a tab
# that is already open, FCM is for reaching someone who is elsewhere.
# With this off, the stream endpoints return 503 and the app falls back to its
# previous fetch-on-load behaviour. Every REST endpoint is unaffected.
REALTIME_ENABLED=true
# Lifetime of the single-purpose SSE ticket. Short because it travels in a
# query string, where it lands in access and proxy logs.
REALTIME_TICKET_TTL_SECONDS=60
# How often a live connection re-resolves project access. This is the window in
# which a user removed from a project can still receive its events.
REALTIME_AUTH_TTL_SECONDS=30
# Comment frames that stop idle proxies dropping the stream.
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_RETRY_MS=3000
REALTIME_MAX_QUEUE=100

# --- MCP tool surface ---
# Exposes the existing AI tool layer over the Model Context Protocol, one
# server per project: POST /api/v1/mcp/projects/{id}. Off by default — a new
# externally-reachable protocol is an operator's decision. It adds no
# capability; every tool is one the agent runtime already calls, behind the
# same permission. See docs/MCP.md.
MCP_ENABLED=false

# Per-credential throttle on tools/call. The platform's only other rate limit
# covers login, which left an MCP client able to call tools as fast as the API
# would answer. Counted per credential (not per user, so a runaway desktop
# client cannot throttle the same person's browser) and per call (a batch costs
# one unit per tool call it carries). Set MCP_RATE_LIMIT_CALLS=0 to switch
# limiting off, only where nothing untrusted can reach the port.
MCP_RATE_LIMIT_CALLS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60

# --- MCP client tokens ---
# Long-lived, project-scoped credentials for desktop MCP clients, which run for
# weeks and cannot refresh a minutes-long access token. Minted at
# POST /api/v1/mcp/tokens, usable only against the MCP endpoint, revocable in
# one request. Always bounded: a credential with no end is one nobody gets
# round to revoking.
MCP_TOKEN_DEFAULT_LIFETIME_DAYS=30
MCP_TOKEN_MAX_LIFETIME_DAYS=90
MCP_TOKENS_PER_USER_MAX=10
